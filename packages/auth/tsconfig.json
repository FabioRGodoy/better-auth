{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],

    "rootDir": "src",
    "outDir": "dist",

    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],

    "declaration": true,
    "emitDeclarationOnly": false,
    "isolatedModules": true
  },
  "include": ["src/**/*"]
}
