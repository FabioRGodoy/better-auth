{
  "name": "@repo/auth",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./server": {
      "import": "./dist/server/index.js"
    },
    "./client": {
      "import": "./dist/client/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/server/index.d.ts"
      ],
      "client": [
        "dist/client/index.d.ts"
      ],
      "*": [
        "dist/*"
      ]
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@repo/database": "workspace:*",
    "better-auth": "^1.3.28"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.5.4",
    "@types/node": "^24.9.1"
  }
}
